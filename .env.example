# Copy to .env and change the key. Never commit a real .env.
API_KEY=change-me-in-production
DATABASE_URL=sqlite:///./alertlens.db
# For Postgres: DATABASE_URL=postgresql+psycopg2://alertlens:alertlens@localhost:5432/alertlens
DEDUP_WINDOW_SECONDS=300
CORRELATION_WINDOW_SECONDS=3600
RECALL_TARGET=0.95
RATE_LIMIT_PER_MINUTE=60
LLM_ENABLED=false
# OPENAI_API_KEY=  # only needed if LLM_ENABLED=true
MODEL_PATH=models/model.pkl
VITE_API_URL=http://localhost:8000
VITE_API_KEY=change-me-in-production
