# Copy to .env and change the key. Never commit a real .env.
#
# docker compose REQUIRES API_KEY — compose fails fast with
# "Set API_KEY in .env" if it is missing (no fallback default).
# Use letters/digits only (no $ or double quotes): the key is substituted
# into the nginx config by envsubst (see frontend/nginx.conf.template).
API_KEY=change-me-in-production
# SEED_DEMO=true loads data/sample_alerts.csv into the API container at
# start (docker only). Default false: a restart must not re-seed.
SEED_DEMO=false
DATABASE_URL=sqlite:///./alertlens.db
# For Postgres: DATABASE_URL=postgresql+psycopg2://alertlens:alertlens@localhost:5432/alertlens
DEDUP_WINDOW_SECONDS=300
CORRELATION_WINDOW_SECONDS=3600
RECALL_TARGET=0.95
RATE_LIMIT_PER_MINUTE=60
LLM_ENABLED=false
# OPENAI_API_KEY=  # only needed if LLM_ENABLED=true
MODEL_PATH=models/model.pkl
# No build-time key variables anymore: the browser talks to same-origin
# /api and nginx injects X-API-Key server-side (frontend/nginx.conf.template).
# In local dev, Vite proxies /api to http://localhost:8000 (vite.config.js).
